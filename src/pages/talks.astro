---
import { getCollection } from 'astro:content';

// Get all events and talks to find the latest event with talks.
const events = await getCollection('events');
const talks = await getCollection('talks');

const eventsWithTalks = events.filter(event => {
  const slug = event.id.replace('.md', '');
  return talks.some(t => t.data.eventSlug === slug);
});

const latestEvent = eventsWithTalks.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())[0];

// If a latest event with talks is found, redirect to its talks page.
if (latestEvent) {
  return Astro.redirect(`/talks/${latestEvent.id.replace('.md', '')}`);
}

// If no events are found, return a 404 response.
return new Response('No events found', { status: 404 });
---
