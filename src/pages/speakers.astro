---
import { getCollection } from 'astro:content';

// Get all events and talks to find the latest event with speakers.
const events = await getCollection('events');
const talks = await getCollection('talks');

const eventsWithSpeakers = events.filter(event => {
  const slug = event.id.replace('.md', '');
  return talks.some(t => t.data.eventSlug === slug && t.data.speakers && t.data.speakers.length > 0);
});

const latestEvent = eventsWithSpeakers.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())[0];

// If a latest event with speakers is found, redirect to its speakers page.
if (latestEvent) {
  return Astro.redirect(`/speakers/${latestEvent.id.replace('.md', '')}`);
}

// If no events are found, return a 404 response.
return new Response('No events found', { status: 404 });
---
